{
  "name": "rimotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/validate-browser.mjs",
    "benchmark:export": "node scripts/benchmark-export.mjs",
    "cli": "node bin/rimotion.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "test:cli": "node scripts/validate-cli.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "playwright": "^1.56.0",
    "@webgpu/types": "^0.1.65"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "rimotion": "bin/rimotion.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "cli",
    "src",
    "index.html",
    "README.md",
    "AI_AUTHORING.md",
    "CLI.md"
  ]
}
