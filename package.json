{
  "name": "rimotion",
  "version": "0.1.0",
  "description": "Code-first WebGPU video framework. Preview, render a PNG frame, and export H.264 MP4 from a project manifest.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/validate-browser.mjs",
    "test:preview": "node scripts/validate-preview.mjs",
    "benchmark:preview": "node scripts/diagnose-preview.mjs",
    "benchmark:export": "node scripts/benchmark-export.mjs",
    "cli": "node bin/rimotion.mjs",
    "test:cli": "node scripts/validate-cli.mjs",
    "benchmark:pipelines": "node scripts/benchmark-pipelines.mjs",
    "test:export": "node scripts/validate-export-pipeline.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.65",
    "cn": "^0.5.0",
    "playwright-core": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.15.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "rimotion": "bin/rimotion.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "cli",
    "src",
    "index.html",
    "README.md",
    "AI_AUTHORING.md",
    "CLI.md"
  ]
}
