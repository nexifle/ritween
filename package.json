{
  "name": "ritween",
  "version": "0.2.2",
  "description": "Code-first WebGPU video framework. Preview, render a PNG frame, and export H.264 MP4 from a project manifest.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.cli.json && node scripts/build-runtime.mjs && npm run build:types",
    "build:types": "node scripts/build-types.mjs",
    "prepack": "npm run build",
    "preview": "node bin/ritween.mjs preview --demo",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/validate-browser.mjs",
    "test:media": "node --import tsx scripts/validate-media.mjs",
    "test:mp4-input": "node --import tsx scripts/validate-mp4-input.mjs",
    "test:preview": "node --import tsx scripts/validate-preview.mjs",
    "test:live-preview": "node scripts/validate-live-preview.mjs",
    "test:project-settings": "node --import tsx scripts/validate-project-settings.mjs",
    "test:studio-preferences": "node --import tsx scripts/validate-studio-preferences.mjs",
    "benchmark:preview": "node scripts/diagnose-preview.mjs",
    "benchmark:export": "node scripts/benchmark-export.mjs",
    "cli": "node bin/ritween.mjs",
    "test:cli": "node scripts/validate-cli.mjs",
    "benchmark:pipelines": "node scripts/benchmark-pipelines.mjs",
    "test:export": "node scripts/validate-export-pipeline.mjs",
    "test:compression": "node scripts/validate-compressed-export.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.65",
    "cn": "^0.5.0",
    "playwright-core": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.15.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "ritween": "bin/ritween.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "types",
    "bin",
    "dist",
    "README.md",
    "CLI.md",
    "LICENSE",
    "docs/technical-guide.md"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT",
  "homepage": "https://ritween.nexifle.com",
  "author": {
    "name": "Nexifle Lab",
    "url": "https://nexifle.com"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexifle/ritween.git"
  }
}
